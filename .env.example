APP_NAME=AI_POWER_HUB
APP_ENV=development
DEBUG=false
# SQLite is for local development only; use PostgreSQL in production.
DATABASE_URL=sqlite:///./ai_power_hub.db
# Replace this placeholder with a random secret of at least 32 characters.
SECRET_KEY=replace-with-a-random-secret-before-deployment
ACCESS_TOKEN_MINUTES=30
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=
REDIS_URL=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
PAYMENT_GATEWAY_SECRET=
SAFEPAY_WEBHOOK_SECRET=
SAFEPAY_API_KEY=
SAFEPAY_SECRET_KEY=
SAFEPAY_ENVIRONMENT=sandbox
PUBLIC_APP_URL=
APP_ORIGIN=https://your-domain.example
POSTGRES_PASSWORD=replace-with-random-hex-secret
REDIS_PASSWORD=replace-with-random-hex-secret
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=3000
